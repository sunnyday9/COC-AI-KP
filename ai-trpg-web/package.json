{
  "name": "ai-trpg-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "sync:tools": "node scripts/sync-tools.cjs",
    "test:run": "npm run sync:tools && vitest run",
    "test:electron:smoke": "electron electron/integration/smoke.cjs",
    "test:e2e:electron": "npm run build && cross-env E2E_FORCE_PROD=1 E2E_MOCK_AI=1 node e2e/electron.e2e.mjs",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "@langchain/core": "^1.1.24",
    "@langchain/langgraph": "^1.1.4",
    "@xenova/transformers": "^2.17.2",
    "electron-store": "^11.0.2",
    "openai": "^4.73.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdf-to-img": "^5.0.0",
    "pinia": "^3.0.4",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "vue": "^3.5.25",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^40.4.1",
    "electron-builder": "^26.7.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^28.1.0",
    "playwright-core": "^1.55.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.1.5",
    "wait-on": "^8.0.1"
  }
}
