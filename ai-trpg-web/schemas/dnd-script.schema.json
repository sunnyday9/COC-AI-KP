{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "D&D Script",
  "description": "龙与地下城 TRPG 剧本结构",
  "type": "object",
  "required": ["meta", "scenes"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "ruleSystem"],
      "properties": {
        "title": { "type": "string" },
        "author": { "type": "string" },
        "ruleSystem": { "const": "dnd" },
        "version": { "type": "string" }
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "npcIds": { "type": "array", "items": { "type": "string" } },
          "encounterIds": { "type": "array", "items": { "type": "string" } },
          "transitionCondition": { "type": "string" }
        }
      }
    },
    "npcs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "dialogueStyle": { "type": "string" },
          "stats": {
            "type": "object",
            "properties": {
              "ac": { "type": "number" },
              "hp": { "type": "number" }
            }
          }
        }
      }
    },
    "encounters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "dcChecks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "description": { "type": "string" },
                "dc": { "type": "number" },
                "skill": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "skill": { "type": "string" },
          "dc": { "type": "number" },
          "successSceneId": { "type": "string" },
          "failSceneId": { "type": "string" }
        }
      }
    }
  }
}
